# Supabase (Required — for session sync, resume vault, and auth)
# Get these from your Supabase project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Groq API (Required for real-time AI answers in the HUD)
# The AI Answer Engine and Vision Problem Solver require this key.
# Keys start with: gsk_
VITE_GROQ_API_KEY=gsk_your-key-here
