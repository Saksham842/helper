# Environment Variables Setup
#
# Copy per-app .env files before running:
#   cp apps/web/.env.example apps/web/.env.local
#   cp apps/desktop/.env.example apps/desktop/.env
#
# See each file for required and optional variables:
#   apps/web/.env.example    — NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, GROQ_API_KEY
#   apps/desktop/.env.example — VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_GROQ_API_KEY
